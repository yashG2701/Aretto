{%- liquid
  assign hf = section.settings.heading_font | strip | replace: ' ', '+'
  assign bf = section.settings.body_font | strip | replace: ' ', '+'
  assign rating = section.settings.rating_x10 | divided_by: 10.0
  assign visible = section.settings.visible_cards | plus: 0
-%}

{%- capture star_path -%}M12 2.3l2.95 6 6.6.95-4.78 4.65 1.13 6.57L12 17.36l-5.9 3.1 1.13-6.57L2.45 9.25l6.6-.95z{%- endcapture -%}

{%- if section.settings.load_google_fonts -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family={{ hf }}:wght@{{ section.settings.heading_weight }}&family={{ bf }}:wght@400;500;600;700&display=swap" rel="stylesheet">
{%- endif -%}

<style>
  #crv-{{ section.id }} {
    --crv-heading-font: {% if section.settings.load_google_fonts %}'{{ section.settings.heading_font }}', {% endif %}var(--font-heading-family, sans-serif);
    --crv-body-font: {% if section.settings.load_google_fonts %}'{{ section.settings.body_font }}', {% endif %}var(--font-body-family, sans-serif);
    --crv-star: {{ section.settings.star_color }};
    --crv-card: {{ section.settings.card_color }};
    --crv-radius: {{ section.settings.radius }}px;
    --crv-gap: 30px;
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    font-family: var(--crv-body-font);
    color: #111;
  }
  #crv-{{ section.id }} .crv-inner { max-width: {{ section.settings.max_width }}px; margin: 0 auto; }

  #crv-{{ section.id }} .crv-head { text-align: center; margin-bottom: 48px; }
  #crv-{{ section.id }} .crv-eyebrow {
    font-family: var(--crv-body-font);
    font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    color: {{ section.settings.eyebrow_color }};
    margin: 0 0 12px;
  }
  #crv-{{ section.id }} .crv-heading {
    font-family: var(--crv-heading-font);
    font-weight: {{ section.settings.heading_weight }};
    font-size: clamp(26px, 4vw, {{ section.settings.heading_size }}px);
    line-height: 1.1; text-transform: uppercase; margin: 0;
    color: {{ section.settings.heading_color }};
  }

  #crv-{{ section.id }} .crv-layout {
    display: grid;
    grid-template-columns: {% if section.settings.show_summary %}300px {% endif %}minmax(0, 1fr);
    gap: var(--crv-gap);
    align-items: stretch;
  }

  /* ---------- Stars ---------- */
  #crv-{{ section.id }} .crv-stars { display: inline-flex; gap: 6px; }
  #crv-{{ section.id }} .crv-star { position: relative; width: 20px; height: 20px; display: inline-block; }
  #crv-{{ section.id }} .crv-star svg { width: 100%; height: 100%; display: block; }
  #crv-{{ section.id }} .crv-star .crv-empty { fill: #E3E3E3; }
  #crv-{{ section.id }} .crv-star .crv-fill { position: absolute; inset: 0; overflow: hidden; }
  #crv-{{ section.id }} .crv-star .crv-fill svg { width: 20px; height: 20px; fill: var(--crv-star); }
  #crv-{{ section.id }} .crv-stars--lg .crv-star,
  #crv-{{ section.id }} .crv-stars--lg .crv-star .crv-fill svg { width: 22px; height: 22px; }

  /* ---------- Summary card ---------- */
  #crv-{{ section.id }} .crv-summary {
    background: var(--crv-card);
    border: 1px solid #E5E7EB;
    border-radius: var(--crv-radius);
    padding: 28px 28px 32px;
    display: flex; flex-direction: column;
  }
  #crv-{{ section.id }} .crv-score { display: flex; align-items: center; justify-content: center; gap: 14px; }
  #crv-{{ section.id }} .crv-score-num {
    font-family: var(--crv-heading-font);
    font-weight: {{ section.settings.heading_weight }};
    font-size: 64px; line-height: 1;
  }
  #crv-{{ section.id }} .crv-score-count { font-size: 17px; line-height: 1.2; color: #333; }
  #crv-{{ section.id }} .crv-score-count strong { display: block; font-weight: 500; color: #111; text-align: center; }
  #crv-{{ section.id }} .crv-summary > .crv-stars { justify-content: center; margin: 14px 0 32px; }

  #crv-{{ section.id }} .crv-bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  #crv-{{ section.id }} .crv-bar-row { display: grid; grid-template-columns: 30px 1fr 40px; align-items: center; gap: 8px; }
  #crv-{{ section.id }} .crv-bar-label { display: flex; align-items: center; gap: 3px; font-weight: 600; font-size: 15px; }
  #crv-{{ section.id }} .crv-bar-label svg { width: 14px; height: 14px; fill: #111; }
  #crv-{{ section.id }} .crv-bar-track { height: 7px; border-radius: 7px; background: #D9D9D9; overflow: hidden; }
  #crv-{{ section.id }} .crv-bar-fill { height: 100%; border-radius: 7px; background: var(--crv-star); width: 0; transition: width 1s cubic-bezier(.2,.7,.2,1); }
  #crv-{{ section.id }}.is-visible .crv-bar-fill { width: var(--w); }
  #crv-{{ section.id }} .crv-bar-pct { text-align: right; font-size: 13.5px; color: #444; }

  #crv-{{ section.id }} .crv-fit { border-top: 1px solid #DCDCDC; margin-top: 30px; padding-top: 22px; text-align: center; }
  #crv-{{ section.id }} .crv-fit-title { font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: .02em; margin: 0 0 18px; }
  #crv-{{ section.id }} .crv-fit-track {
    position: relative; height: 6px; border-radius: 6px;
    background: linear-gradient(to right, #F1D7C4, #D3E5D0 50%, #F1D7C4);
  }
  #crv-{{ section.id }} .crv-fit-dot {
    position: absolute; top: 50%; left: {{ section.settings.fit_position }}%;
    width: 15px; height: 15px; border-radius: 50%;
    background: #fff; border: 3px solid {{ section.settings.fit_color }};
    transform: translate(-50%, -50%);
  }
  #crv-{{ section.id }} .crv-fit-labels { display: flex; justify-content: space-between; margin-top: 10px; font-size: 12px; font-weight: 600; color: #444; }
  #crv-{{ section.id }} .crv-fit-note { margin: 12px 0 0; font-size: 14px; font-weight: 600; color: {{ section.settings.fit_color }}; }

  /* ---------- Review cards ---------- */
  #crv-{{ section.id }} .crv-slider { position: relative; min-width: 0; display: flex; flex-direction: column; }
  #crv-{{ section.id }} .crv-track {
    display: flex; gap: var(--crv-gap);
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
    scrollbar-width: none; -ms-overflow-style: none;
    flex: 1;
  }
  #crv-{{ section.id }} .crv-track::-webkit-scrollbar { display: none; }
  #crv-{{ section.id }} .crv-card {
    flex: 0 0 calc((100% - var(--crv-gap) * {{ visible | minus: 1 }}) / {{ visible }});
    scroll-snap-align: start;
    background: var(--crv-card);
    border: 1px solid #E5E7EB;
    border-radius: var(--crv-radius);
    overflow: hidden;
    display: flex; flex-direction: column;
  }
  #crv-{{ section.id }} .crv-photo { position: relative; aspect-ratio: {{ section.settings.photo_ratio }}; background: #e9e9e9; }
  #crv-{{ section.id }} .crv-photo img,
  #crv-{{ section.id }} .crv-photo svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  #crv-{{ section.id }} .crv-body { padding: 20px 20px 22px; display: flex; flex-direction: column; flex: 1; }
  #crv-{{ section.id }} .crv-text { font-size: 14.5px; line-height: 1.4; color: #444; margin: 14px 0 18px; flex: 1; }
  #crv-{{ section.id }} .crv-text p { margin: 0; }
  #crv-{{ section.id }} .crv-meta { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  #crv-{{ section.id }} .crv-name { font-size: 16px; font-weight: 600; color: #111; }
  #crv-{{ section.id }} .crv-city { font-size: 14px; color: #555; }

  #crv-{{ section.id }} .crv-nav { display: flex; justify-content: center; gap: 10px; margin-top: 24px; }
  #crv-{{ section.id }} .crv-nav[hidden] { display: none; }
  #crv-{{ section.id }} .crv-arrow {
    width: 42px; height: 42px; border-radius: 50%;
    border: 1px solid #D1D5DB; background: #fff; color: #111;
    display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer; transition: background .2s, opacity .2s;
  }
  #crv-{{ section.id }} .crv-arrow:hover:not(:disabled) { background: #111; color: #fff; border-color: #111; }
  #crv-{{ section.id }} .crv-arrow:disabled { opacity: .35; cursor: default; }
  #crv-{{ section.id }} .crv-arrow svg { width: 18px; height: 18px; }

  /* ---------- Responsive ---------- */
  @media (max-width: 989px) {
    #crv-{{ section.id }} .crv-layout { grid-template-columns: 1fr; }
    #crv-{{ section.id }} .crv-summary { max-width: 420px; width: 100%; margin: 0 auto; }
    #crv-{{ section.id }} .crv-card { flex-basis: calc((100% - var(--crv-gap)) / 2); }
  }
  @media (max-width: 749px) {
    #crv-{{ section.id }} { --crv-gap: 14px; }
    #crv-{{ section.id }} .crv-head { margin-bottom: 28px; }
    #crv-{{ section.id }} .crv-card { flex-basis: 84%; }
    #crv-{{ section.id }} .crv-track { margin: 0 -20px; padding: 0 20px; scroll-padding: 0 20px; }
  }
</style>

<section id="crv-{{ section.id }}">
  <div class="crv-inner">
    <div class="crv-head">
      {%- if section.settings.eyebrow != blank -%}<p class="crv-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="crv-heading">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>

    <div class="crv-layout">
      {%- if section.settings.show_summary -%}
        <div class="crv-summary">
          <div class="crv-score">
            <span class="crv-score-num">{{ rating }}</span>
            <span class="crv-score-count"><strong>{{ section.settings.review_count }}</strong>Reviews</span>
          </div>

          <div class="crv-stars crv-stars--lg" aria-label="Rated {{ rating }} out of 5">
            {%- for i in (0..4) -%}
              {%- assign f = i | times: 10 -%}
              {%- assign f = section.settings.rating_x10 | minus: f -%}
              {%- if f > 10 -%}{%- assign f = 10 -%}{%- endif -%}
              {%- if f < 0 -%}{%- assign f = 0 -%}{%- endif -%}
              <span class="crv-star">
                <svg viewBox="0 0 24 24" class="crv-empty"><path d="{{ star_path }}"/></svg>
                <span class="crv-fill" style="width: {{ f | times: 10 }}%;"><svg viewBox="0 0 24 24"><path d="{{ star_path }}"/></svg></span>
              </span>
            {%- endfor -%}
          </div>

          <ul class="crv-bars">
            {%- assign pcts = section.settings.pct_5 | append: ',' | append: section.settings.pct_4 | append: ',' | append: section.settings.pct_3 | append: ',' | append: section.settings.pct_2 | append: ',' | append: section.settings.pct_1 | split: ',' -%}
            {%- for p in pcts -%}
              <li class="crv-bar-row">
                <span class="crv-bar-label">{{ 6 | minus: forloop.index }}<svg viewBox="0 0 24 24"><path d="{{ star_path }}"/></svg></span>
                <span class="crv-bar-track"><span class="crv-bar-fill" style="--w: {{ p }}%;"></span></span>
                <span class="crv-bar-pct">{{ p }}%</span>
              </li>
            {%- endfor -%}
          </ul>

          {%- if section.settings.show_fit -%}
            <div class="crv-fit">
              <p class="crv-fit-title">{{ section.settings.fit_title }}</p>
              <div class="crv-fit-track"><span class="crv-fit-dot"></span></div>
              <div class="crv-fit-labels"><span>Small</span><span>True to size</span><span>Large</span></div>
              {%- if section.settings.fit_note != blank -%}<p class="crv-fit-note">{{ section.settings.fit_note }}</p>{%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="crv-slider">
        <div class="crv-track">
          {%- for block in section.blocks -%}
            <article class="crv-card" {{ block.shopify_attributes }}>
              <div class="crv-photo">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '350, 500, 700, 900', sizes: '(min-width: 990px) 360px, 84vw', alt: block.settings.name }}
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag }}
                {%- endif -%}
              </div>
              <div class="crv-body">
                <div class="crv-stars" aria-label="Rated {{ block.settings.stars }} out of 5">
                  {%- assign s = block.settings.stars | plus: 0 -%}
                  {%- for i in (1..5) -%}
                    <span class="crv-star">
                      <svg viewBox="0 0 24 24" class="crv-empty"><path d="{{ star_path }}"/></svg>
                      {%- if i <= s -%}<span class="crv-fill" style="width:100%;"><svg viewBox="0 0 24 24"><path d="{{ star_path }}"/></svg></span>{%- endif -%}
                    </span>
                  {%- endfor -%}
                </div>
                <div class="crv-text">{{ block.settings.text }}</div>
                <div class="crv-meta">
                  <span class="crv-name">{{ block.settings.name }}</span>
                  {%- if block.settings.city != blank -%}<span class="crv-city">{{ block.settings.city }}</span>{%- endif -%}
                </div>
              </div>
            </article>
          {%- endfor -%}
        </div>

        <div class="crv-nav" hidden>
          <button type="button" class="crv-arrow crv-prev" aria-label="Previous reviews">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <button type="button" class="crv-arrow crv-next" aria-label="Next reviews">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('crv-{{ section.id }}');
    if (!root || root.dataset.crvReady) return;
    root.dataset.crvReady = '1';

    /* animate bars when visible */
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (en) {
        if (en[0].isIntersecting) { root.classList.add('is-visible'); io.disconnect(); }
      }, { threshold: 0.2 });
      io.observe(root);
    } else { root.classList.add('is-visible'); }

    var track = root.querySelector('.crv-track');
    var nav = root.querySelector('.crv-nav');
    var prev = root.querySelector('.crv-prev');
    var next = root.querySelector('.crv-next');

    function step() {
      var card = track.querySelector('.crv-card');
      if (!card) return 0;
      var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 0;
      return card.getBoundingClientRect().width + gap;
    }
    function update() {
      var max = track.scrollWidth - track.clientWidth;
      nav.hidden = max <= 4;
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft >= max - 4;
    }
    prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
    next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
    track.addEventListener('scroll', function () { window.requestAnimationFrame(update); }, { passive: true });
    window.addEventListener('resize', update);
    update();

    document.addEventListener('shopify:block:select', function (e) {
      if (track.contains(e.target)) {
        track.scrollTo({ left: e.target.offsetLeft - track.offsetLeft, behavior: 'smooth' });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Customer Reviews",
  "tag": "div",
  "class": "section-customer-reviews",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Testimonials" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What our customers say" },

    { "type": "header", "content": "Rating summary" },
    { "type": "checkbox", "id": "show_summary", "label": "Show rating summary card", "default": true },
    { "type": "range", "id": "rating_x10", "label": "Average rating (× 10)", "min": 10, "max": 50, "step": 1, "default": 48, "info": "48 = 4.8 stars, 45 = 4.5 stars" },
    { "type": "text", "id": "review_count", "label": "Number of reviews", "default": "118" },
    { "type": "range", "id": "pct_5", "label": "5 star %", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 80 },
    { "type": "range", "id": "pct_4", "label": "4 star %", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 11 },
    { "type": "range", "id": "pct_3", "label": "3 star %", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 7 },
    { "type": "range", "id": "pct_2", "label": "2 star %", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 1 },
    { "type": "range", "id": "pct_1", "label": "1 star %", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 1 },

    { "type": "header", "content": "Fit meter" },
    { "type": "checkbox", "id": "show_fit", "label": "Show fit meter", "default": true },
    { "type": "text", "id": "fit_title", "label": "Fit title", "default": "How's the fit?" },
    { "type": "range", "id": "fit_position", "label": "Fit position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50, "info": "0 = Small, 50 = True to size, 100 = Large" },
    { "type": "text", "id": "fit_note", "label": "Fit note", "default": "94% say true to size*" },
    { "type": "color", "id": "fit_color", "label": "Fit accent color", "default": "#1E9E4A" },

    { "type": "header", "content": "Fonts" },
    { "type": "checkbox", "id": "load_google_fonts", "label": "Use custom Google Fonts", "default": true, "info": "Turn off to use your theme's fonts instead." },
    { "type": "text", "id": "heading_font", "label": "Heading font (Google Font name)", "default": "Oswald" },
    {
      "type": "select", "id": "heading_weight", "label": "Heading weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700",
      "info": "Use Regular if your heading font is Anton."
    },
    { "type": "text", "id": "body_font", "label": "Body font (Google Font name)", "default": "Inter" },

    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "visible_cards", "label": "Review cards visible (desktop)",
      "options": [ { "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" } ],
      "default": "2"
    },
    {
      "type": "select", "id": "photo_ratio", "label": "Photo shape",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait (4:5)" },
        { "value": "4 / 3", "label": "Landscape (4:3)" }
      ],
      "default": "1 / 1"
    },
    { "type": "range", "id": "max_width", "label": "Content width", "min": 800, "max": 1600, "step": 20, "unit": "px", "default": 1060 },

    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "card_color", "label": "Card background", "default": "#F3F4F6" },
    { "type": "color", "id": "star_color", "label": "Star & bar color", "default": "#F5A300" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow color", "default": "#2B2BE0" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#111111" },
    { "type": "range", "id": "heading_size", "label": "Heading max size", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 38 },
    { "type": "range", "id": "radius", "label": "Card corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer photo", "info": "Recommended: 900 × 900 px" },
        {
          "type": "select", "id": "stars", "label": "Stars",
          "options": [
            { "value": "5", "label": "5" }, { "value": "4", "label": "4" }, { "value": "3", "label": "3" },
            { "value": "2", "label": "2" }, { "value": "1", "label": "1" }
          ],
          "default": "5"
        },
        { "type": "richtext", "id": "text", "label": "Review", "default": "<p>Lorem ipsum dolor sit amet consectetur. Accumsan sed sit sit phasellus. Eu cras ante est in non consectetur posuere.</p>" },
        { "type": "text", "id": "name", "label": "Customer name", "default": "Customer name" },
        { "type": "text", "id": "city", "label": "City", "default": "City" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Customer Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}